    {
      "parameters": {
        "jsCode": "// Combine weekly ticket summary + feedback themes into one readable report\nconst summaryRows = $('Fetch Weekly Summary').all().map(i => i.json);\nconst themeRows = $input.all().map(i => i.json);\n\nlet report = '<h2>Weekly Support Analytics</h2>';\nreport += '<h3>Ticket Volume by Category & Priority</h3><table border=\"1\" cellpadding=\"6\"><tr><th>Week</th><th>Category</th><th>Priority</th><th>Tickets</th><th>Avg Resolution (hrs)</th></tr>';\nfor (const r of summaryRows) {\n  report += `<tr><td>${r.week}</td><td>${r.category}</td><td>${r.priority}</td><td>${r.ticket_count}</td><td>${r.avg_resolution_hours ?? '-'}</td></tr>`;\n}\nreport += '</table>';\n\nreport += '<h3>Feedback Themes (last 7 days)</h3><table border=\"1\" cellpadding=\"6\"><tr><th>Theme</th></tr>';\nfor (const r of themeRows) {\n  report += `<tr><td>${r.theme}</td></tr>`;\n}\nreport += '</table>';\n\nreturn { json: { report_html: report } };"
      },

    {
      "parameters": {
        "jsCode": "// Basic keyword-based theming (lightweight, no extra AI call needed)\nconst body = $input.item.json.body;\nconst comment = (body.comment || '').toLowerCase();\n\nconst themeMap = {\n  slow_response: ['slow', 'delay', 'wait', 'long time'],\n  helpful_agent: ['helpful', 'great', 'friendly', 'kind', 'thank'],\n  unresolved: ['not resolved', 'still broken', 'didn\\'t work', \"didn't fix\"],\n  billing_issue: ['charge', 'billing', 'refund', 'payment']\n};\n\nconst tags = [];\nfor (const [tag, keywords] of Object.entries(themeMap)) {\n  if (keywords.some(k => comment.includes(k))) tags.push(tag);\n}\n\nreturn {\n  json: {\n    ticket_id: body.ticket_id,\n    rating: body.rating,\n    comment: body.comment || '',\n    theme_tags: tags\n  }\n};"
      },
      "id": "b2f014c9-a0df-4b8f-b676-486fa97e3d61",
      "name": "Tag Feedback Themes",

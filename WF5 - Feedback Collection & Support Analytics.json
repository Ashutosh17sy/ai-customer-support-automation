    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) FILTER (WHERE rating <= 2) AS low_ratings,\n       COUNT(*) AS total_ratings,\n       ROUND(AVG(rating)::numeric, 2) AS avg_rating,\n       unnest(ai_theme_tags) AS theme\nFROM feedback\nWHERE submitted_at > NOW() - INTERVAL '7 days'\nGROUP BY unnest(ai_theme_tags)\nORDER BY COUNT(*) DESC;",
        "options": {}
      },

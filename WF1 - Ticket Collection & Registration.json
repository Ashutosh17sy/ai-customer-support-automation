    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tickets (ticket_ref, customer_id, channel, subject, description, status)\nVALUES (\n  '{{ $('Generate Ticket Reference').item.json.ticket_ref }}',\n  {{ $json.customer_id }},\n  '{{ $('Generate Ticket Reference').item.json.channel }}',\n  '{{ $('Generate Ticket Reference').item.json.subject.replace(/'/g, \"''\") }}',\n  '{{ $('Generate Ticket Reference').item.json.description.replace(/'/g, \"''\") }}',\n  'NEW'\n)\nRETURNING ticket_id, ticket_ref;",
        "options": {}

    {
      "parameters": {
        "jsCode": "// Normalize webhook (website form / chatbot) payload into common ticket schema\nconst body = $input.item.json.body || $input.item.json;\n\nreturn {\n  json: {\n    channel: body.channel === 'chatbot' ? 'chatbot' : 'webform',\n    customer_name: body.name || 'Unknown',\n    customer_email: body.email,\n    subject: body.subject || '(no subject)',\n    description: body.message || body.description || ''\n  }\n};"
      },
      "id": "02007759-500d-4912-8c8f-93f75af7dc41",
      "name": "Normalize Webhook Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize Gmail trigger payload into common ticket schema\nconst msg = $input.item.json;\n\nconst fromHeader = msg.from || (msg.headers && msg.headers.from) || '';\nconst emailMatch = fromHeader.match(/<(.+)>/);\nconst customerEmail = emailMatch ? emailMatch[1] : fromHeader;\nconst nameMatch = fromHeader.split('<')[0].trim();\n\nreturn {\n  json: {\n    channel: 'email',\n    customer_name: nameMatch || 'Unknown',\n    customer_email: customerEmail,\n    subject: msg.subject || '(no subject)',\n    description: msg.text || msg.snippet || ''\n  }\n};"
      },
      "id": "c1bf6d78-9e62-4b82-9a59-5ff77adaa107",
      "name": "Normalize Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate a human-readable ticket reference\nconst ts = Date.now().toString().slice(-8);\nconst rand = Math.floor(Math.random() * 90 + 10);\nconst ticket_ref = `TCK-${ts}${rand}`;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    ticket_ref\n  }\n};"
      },
      "id": "154df71e-1ee1-4ca7-a4a2-a95270d7ec76",
      "name": "Generate Ticket Reference",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        224
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customers (name, email)\nVALUES ('{{ $json.customer_name.replace(/'/g, \"''\") }}', '{{ $json.customer_email }}')\nON CONFLICT (email) DO UPDATE SET name = EXCLUDED.name\nRETURNING customer_id;",
        "options": {}
      },
      "id": "169f3878-bd7d-44d3-b5d3-b6d604317076",
      "name": "Upsert Customer",
